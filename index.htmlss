      </div>
      <div class="mrow"><div class="mname">Kolejna porcja</div><span class="mprice">8 zł</span></div>
      <div class="mrow"><div class="mname">Lody na wynos 500ml<span class="msub">Termobox</span></div><span class="mprice">45 zł</span></div>
      <div class="mrow"><div class="mname">Lody na wynos 1000ml<span class="msub">Termobox</span></div><span class="mprice">80 zł</span></div>
    </div></div>

    <div id="tab-wmaxi" class="menu-panel fade-up"><div class="menu-list">
      <div class="mrow"><div class="mname">Gofr Maxi<span class="msub">2 porcje lodów, bita śmietana, polewa</span></div><span class="mprice">35 zł</span></div>
      <div class="mrow"><div class="mname">Kinder Bueno / White</div><span class="mprice">35 zł</span></div>
      <div class="mrow"><div class="mname">Kinder Mix</div><span class="mprice">35 zł</span></div>
      <div class="mrow"><div class="mname">Maxi King</div><span class="mprice">35 zł</span></div>
