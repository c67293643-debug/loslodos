      <div class="mrow"><div class="mname">Oreo</div><span class="mprice">8 zł</span></div>
      <div class="mrow" style="grid-column:1/-1;background:rgba(249,184,204,0.07);border-top:1px solid rgba(249,184,204,0.1);">
