              <div class="hrow"><span>Niedziela</span><span>12:00 – 20:00</span></div>
            </div>
          </div></div>
        </div>

        <!-- MODUŁ NAWIGACJI -->
        <a href="https://www.google.com/maps/dir/?api=1&destination=ul.+1+Maja+16A,+59-300+Lubin"
           target="_blank" rel="noopener" class="nav-modul" aria-label="Otwórz nawigację Google Maps">
