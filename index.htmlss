<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Los Lodos – Lodziarnia Rzemieślnicza | Lubin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<!--
╔══════════════════════════════════════════════════╗
║  ZDJĘCIA – JAK DODAĆ                            ║
╠══════════════════════════════════════════════════╣
║  Utwórz folder "zdjecia/" obok index.html       ║
║  i wrzuć pliki o poniższych nazwach:            ║
║                                                  ║
║  zdjecia/hero.png   → hero (prawy bok)          ║
║  zdjecia/onas.jpg   → sekcja O nas              ║
║  zdjecia/g1.jpg     → galeria lewa              ║
║  zdjecia/g2.jpg     → galeria środek            ║
║  zdjecia/g3.jpg     → galeria prawa             ║
╚══════════════════════════════════════════════════╝
-->

<style>
:root {
  --pink:       #F9B8CC;
  --pink-light: #FDE8EF;
  --pink-pale:  #FFF0F5;
  --pink-deep:  #E8789A;
  --candy:      #F7D6E8;
  --lavender:   #E8D5F5;
  --sky:        #C8E8FA;
  --mint:       #C8F0E0;
  --white:      #FFFAFB;
  --text:       #2E1220;
  --text-mid:   #7A3A55;
  --text-soft:  #B07090;
  --border:     rgba(249,184,204,0.4);
}

*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior: smooth; }

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--pink-pale);
  color: var(--text);
  overflow-x: hidden;
}

/* ── NAV ── */
nav {
  position: fixed; top:0; left:0; right:0; z-index:100;
  padding: 1.1rem 3rem;
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(255,250,251,0.85);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}
.nav-logo {
  font-family: 'Playfair Display', serif;
  font-size: 1.55rem; font-weight: 700; font-style: italic;
  color: var(--text); text-decoration: none; letter-spacing: -0.01em;
}
.nav-logo span { color: var(--pink-deep); }
.nav-links { display: flex; gap: 2.5rem; list-style: none; }
.nav-links a {
  font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--text-soft); text-decoration: none; font-weight: 500;
  transition: color 0.2s;
}
.nav-links a:hover { color: var(--pink-deep); }
.nav-cta {
  background: var(--pink-deep); color: #fff;
  font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
  font-weight: 500; padding: 0.6rem 1.4rem; text-decoration: none;
  border-radius: 100px; transition: background 0.2s;
}
.nav-cta:hover { background: var(--text); }

/* ── HERO ── */
.hero {
  min-height: 100vh;
  display: flex; align-items: center;
  padding: 7rem 3rem 4rem;
  position: relative; overflow: hidden;
  background: var(--white);
}

/* dekoracyjne bąble w tle */
.hero::before {
  content: '';
  position: absolute; top: -120px; right: -120px;
  width: 600px; height: 600px; border-radius: 50%;
  background: radial-gradient(circle, #FDE8EF 0%, #F9B8CC 50%, transparent 75%);
  opacity: 0.6; pointer-events: none;
}
.hero::after {
  content: '';
  position: absolute; bottom: -80px; left: 15%;
  width: 300px; height: 300px; border-radius: 50%;
  background: radial-gradient(circle, var(--lavender) 0%, transparent 70%);
  opacity: 0.5; pointer-events: none;
}

.hero-inner {
  max-width: 1200px; margin: 0 auto; width: 100%;
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 4rem; align-items: center;
  position: relative; z-index: 2;
}

.hero-tag {
  display: inline-flex; align-items: center; gap: 0.5rem;
  background: var(--pink-light); border: 1px solid var(--border);
  padding: 0.35rem 0.9rem; border-radius: 100px;
  font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--pink-deep); font-weight: 500; margin-bottom: 1.75rem;
}
.hero-tag::before { content: '✦'; font-size: 0.65rem; }

.hero-headline {
  font-family: 'Playfair Display', serif;
  font-size: clamp(3rem, 5.5vw, 5rem);
  font-weight: 700; line-height: 1.05;
  color: var(--text); margin-bottom: 1.5rem; letter-spacing: -0.02em;
}
.hero-headline em {
  font-style: italic; color: var(--pink-deep);
  position: relative;
}

.hero-sub {
  font-size: 1rem; line-height: 1.8;
  color: var(--text-mid); font-weight: 300;
  max-width: 420px; margin-bottom: 2.5rem;
}

.hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }
.btn-main {
  background: var(--text); color: var(--pink-light);
  font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase;
  font-weight: 500; padding: 0.9rem 2rem; text-decoration: none;
  border-radius: 100px; transition: all 0.25s;
}
.btn-main:hover { background: var(--pink-deep); }
.btn-outline {
  border: 1.5px solid var(--border); color: var(--text-soft);
  font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase;
  font-weight: 500; padding: 0.9rem 1.75rem; text-decoration: none;
  border-radius: 100px; transition: all 0.25s;
}
.btn-outline:hover { border-color: var(--pink-deep); color: var(--pink-deep); }

/* Prawa strona hero – ozdobna karta */
.hero-visual {
  position: relative;
  display: flex; align-items: center; justify-content: center;
}

.hero-card {
  background: linear-gradient(145deg, var(--candy) 0%, var(--pink-light) 60%, var(--lavender) 100%);
  border-radius: 32px;
  width: 100%; aspect-ratio: 3/4;
  max-width: 380px;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  position: relative; overflow: hidden;
  box-shadow: 0 30px 80px rgba(232,120,154,0.2), 0 8px 24px rgba(232,120,154,0.1);
}

/* dekoracje w karcie */
.hero-card::before {
  content: '';
  position: absolute; top: -40px; right: -40px;
  width: 180px; height: 180px; border-radius: 50%;
  background: rgba(255,255,255,0.4);
}
.hero-card::after {
  content: '';
  position: absolute; bottom: -30px; left: -30px;
  width: 140px; height: 140px; border-radius: 50%;
  background: rgba(255,255,255,0.25);
}

/* Wstaw zdjęcie hero tutaj */
.hero-card img {
  width: 85%;
  height: 80%;
  object-fit: contain;
  position: relative; z-index: 2;
  filter: drop-shadow(0 12px 30px rgba(232,120,154,0.35));
  display: none; /* pojawi się gdy plik istnieje */
}

.hero-card-emoji {
  font-size: 8rem; position: relative; z-index: 2;
  animation: float 3s ease-in-out infinite;
  /* USUŃ tę div gdy dodasz prawdziwe zdjęcie */
}

.hero-card-label {
  position: absolute; bottom: 1.5rem; left: 50%; transform: translateX(-50%);
  background: rgba(255,255,255,0.8); backdrop-filter: blur(8px);
  border-radius: 100px; padding: 0.4rem 1rem;
  font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--text-mid); font-weight: 500; white-space: nowrap;
  z-index: 3;
}

.hero-badge {
  position: absolute; top: -12px; right: -12px;
  background: var(--text); color: var(--pink-light);
  width: 88px; height: 88px; border-radius: 50%;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 1px;
  box-shadow: 0 8px 24px rgba(46,18,32,0.2);
  z-index: 4;
}
.hero-badge-num {
  font-family: 'Playfair Display', serif;
  font-size: 1.9rem; font-weight: 700; color: var(--pink);
  line-height: 1;
}
.hero-badge-text { font-size: 0.52rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-soft); }

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14px); }
}

/* ── MARQUEE ── */
.marquee-wrap {
  background: var(--pink-deep);
  overflow: hidden; padding: 0.9rem 0;
}
.marquee-track {
  display: flex; gap: 2.5rem;
  animation: marquee 20s linear infinite;
  white-space: nowrap; width: max-content;
}
.marquee-item {
  font-family: 'Playfair Display', serif;
  font-style: italic; font-size: 1rem;
  color: rgba(255,240,245,0.9);
  display: flex; align-items: center; gap: 1.5rem;
}
.marquee-item::after { content: '✦'; font-style: normal; font-size: 0.6rem; opacity: 0.7; }

/* ── SEKCJE BAZOWE ── */
section { padding: 7rem 3rem; }
.container { max-width: 1100px; margin: 0 auto; }

.eyebrow {
  font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--pink-deep); font-weight: 500; margin-bottom: 0.75rem;
  display: flex; align-items: center; gap: 0.6rem;
}
.eyebrow::before { content: '✦'; font-size: 0.55rem; }

.section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 4vw, 3.2rem);
  font-weight: 700; line-height: 1.1; color: var(--text);
  margin-bottom: 1.25rem; letter-spacing: -0.02em;
}
.section-title em { font-style: italic; color: var(--pink-deep); }

/* ── SERVICES ── */
.services { background: var(--white); }
.services-layout { display: grid; grid-template-columns: 1fr 2fr; gap: 5rem; align-items: start; }
.services-intro p { font-size: 0.96rem; line-height: 1.8; color: var(--text-mid); font-weight: 300; margin-top: 0.75rem; }
.services-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.service-card {
  background: var(--pink-pale); border: 1px solid var(--border);
  border-radius: 20px; padding: 2rem;
  transition: transform 0.25s, box-shadow 0.25s;
}
.service-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(232,120,154,0.15);
}
.service-icon { font-size: 2.2rem; margin-bottom: 1rem; display: block; }
.service-name {
  font-family: 'Playfair Display', serif;
  font-size: 1.3rem; font-weight: 700; color: var(--text); margin-bottom: 0.5rem;
}
.service-desc { font-size: 0.85rem; line-height: 1.7; color: var(--text-mid); font-weight: 300; }
.service-price { margin-top: 1rem; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--pink-deep); font-weight: 500; }

/* ── GALERIA ── */
.galeria { background: var(--pink-pale); }
.galeria-intro { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem; }
.galeria-note { font-size: 0.8rem; color: var(--text-soft); font-style: italic; }

.galeria-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  grid-template-rows: 240px 240px;
  gap: 1rem;
}
.galeria-item {
  border-radius: 20px; overflow: hidden;
  position: relative;
}
.galeria-item:first-child { grid-row: span 2; }

/* CSS-art placeholdery – wyglądają jak prawdziwe zdjęcia */
.gal-art {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  position: relative; overflow: hidden;
}
.gal-art-1 { background: linear-gradient(145deg, #F9B8CC 0%, #FDE8EF 40%, #E8D5F5 100%); }
.gal-art-2 { background: linear-gradient(145deg, #C8E8FA 0%, #E8D5F5 60%, #F9B8CC 100%); }
.gal-art-3 { background: linear-gradient(145deg, #C8F0E0 0%, #C8E8FA 50%, #E8D5F5 100%); }
.gal-art-4 { background: linear-gradient(145deg, #F7D6E8 0%, #FDE8EF 50%, #C8E8FA 100%); }

.gal-art::before {
  content: '';
  position: absolute; top: -20%; right: -10%;
  width: 60%; height: 60%; border-radius: 50%;
  background: rgba(255,255,255,0.3);
}
.gal-emoji { font-size: clamp(3rem, 6vw, 5.5rem); position: relative; z-index: 1; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.1)); }
.gal-label {
  position: absolute; bottom: 1rem; left: 1rem;
  background: rgba(255,255,255,0.75); backdrop-filter: blur(8px);
  border-radius: 100px; padding: 0.3rem 0.9rem;
  font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--text); font-weight: 500;
}

/* Gdy dodasz zdjęcia, img zastąpi gal-art */
.galeria-item img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 0.5s;
}
.galeria-item:hover img { transform: scale(1.04); }

/* Ścieżka do zdjęcia: zdjecia/g1.jpg, g2.jpg, g3.jpg, g4.jpg */

/* ── MENU ── */
.menu-section { background: var(--text); }
.menu-header { text-align: center; max-width: 560px; margin: 0 auto 3.5rem; }
.menu-header .section-title { color: var(--pink-light); }
.menu-header .eyebrow { justify-content: center; color: var(--pink); }
.menu-header p { font-size: 0.9rem; color: rgba(249,184,204,0.5); font-weight: 300; margin-top: 0.75rem; }

.menu-tabs { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2.5rem; }
.mtab {
  font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: rgba(249,184,204,0.45); border: 1px solid rgba(249,184,204,0.15);
  padding: 0.5rem 1.1rem; cursor: pointer; background: none;
  border-radius: 100px; font-family: 'DM Sans', sans-serif; font-weight: 500;
  transition: all 0.2s;
}
.mtab:hover, .mtab.active {
  background: var(--pink-deep); border-color: var(--pink-deep); color: #fff;
}
.menu-panel { display: none; max-width: 960px; margin: 0 auto; }
.menu-panel.on { display: block; }
.menu-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 1px; background: rgba(249,184,204,0.08); border-radius: 16px; overflow: hidden; }
.mrow {
  background: rgba(46,18,32,0.6);
  padding: 1.1rem 1.5rem;
  display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
  transition: background 0.2s;
}
.mrow:hover { background: rgba(249,184,204,0.07); }
.mname { font-size: 0.88rem; color: #FFF0F5; font-weight: 300; flex: 1; }
.msub { display: block; font-size: 0.72rem; color: rgba(249,184,204,0.35); margin-top: 0.2rem; font-style: italic; }
.mprice { font-family: 'Playfair Display', serif; font-size: 1.05rem; color: var(--pink); white-space: nowrap; }

/* ── OPINIE ── */
.opinie { background: var(--white); }
.opinie-top { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3rem; flex-wrap: wrap; gap: 1.5rem; }
.rating-big { text-align: right; }
.rating-num { font-family: 'Playfair Display', serif; font-size: 3.5rem; font-weight: 700; color: var(--text); line-height: 1; }
.rating-num sup { font-size: 1rem; color: var(--text-soft); font-family: 'DM Sans', sans-serif; font-weight: 300; }
.rating-stars { color: var(--pink-deep); font-size: 1.1rem; letter-spacing: 0.08em; margin: 0.2rem 0; }
.rating-count { font-size: 0.75rem; color: var(--text-soft); }

.opinions-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
.opinion-card {
  background: var(--pink-pale); border: 1px solid var(--border);
  border-radius: 20px; padding: 2rem;
}
.op-stars { color: var(--pink-deep); font-size: 0.85rem; letter-spacing: 0.06em; margin-bottom: 0.9rem; }
.op-text {
  font-family: 'Playfair Display', serif; font-style: italic;
  font-size: 1.05rem; line-height: 1.65; color: var(--text);
  margin-bottom: 1.25rem;
}
.op-name { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-mid); font-weight: 500; }
.op-role { font-size: 0.68rem; color: var(--pink-deep); margin-top: 0.15rem; }

/* ── O NAS ── */
.onas { background: var(--pink-pale); }
.onas-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }

.onas-visual { position: relative; }
.onas-card {
  background: linear-gradient(145deg, var(--candy), var(--pink-light), var(--lavender));
  border-radius: 28px; height: 460px;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden; position: relative;
  box-shadow: 0 24px 60px rgba(232,120,154,0.2);
}
.onas-card::before { content: ''; position: absolute; top:-60px; right:-60px; width:240px; height:240px; border-radius:50%; background: rgba(255,255,255,0.35); }
.onas-card::after { content: ''; position: absolute; bottom:-40px; left:-40px; width:160px; height:160px; border-radius:50%; background: rgba(255,255,255,0.2); }
.onas-emoji { font-size: 7rem; position: relative; z-index: 2; }

/* Gdy dodasz zdjęcie: zdjecia/onas.jpg */
.onas-card img {
  width: 100%; height: 100%; object-fit: cover;
  position: absolute; inset: 0; border-radius: 28px;
  display: none; /* zmień na block gdy plik istnieje */
}

/* ── MODUŁ NAWIGACJI ── */
.nav-modul {
  display: block;
  margin-top: 2rem;
  background: rgba(255,240,245,0.06);
  border: 1px solid rgba(249,184,204,0.2);
  border-radius: 20px;
  padding: 1.25rem 1.5rem;
  text-decoration: none;
  transition: background 0.25s, border-color 0.25s, transform 0.2s, box-shadow 0.25s;
  cursor: pointer;
}
.nav-modul:hover {
  background: rgba(232,120,154,0.12);
  border-color: var(--pink-deep);
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(232,120,154,0.25);
}
.nav-modul-inner {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
}
.nav-modul-icon {
  width: 42px; height: 42px;
  background: var(--pink-deep);
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  color: #fff;
  transition: background 0.2s;
}
.nav-modul:hover .nav-modul-icon { background: var(--pink); }
.nav-modul-icon svg { width: 22px; height: 22px; }
.nav-modul-text {
  display: flex; flex-direction: column; gap: 2px; flex: 1;
}
.nav-modul-label {
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(249,184,204,0.5);
  font-weight: 500;
}
.nav-modul-addr {
  font-size: 0.92rem;
  color: #FFF0F5;
  font-weight: 300;
}
.nav-modul-arrow {
  color: rgba(249,184,204,0.3);
  transition: color 0.2s, transform 0.2s;
}
.nav-modul-arrow svg { width: 20px; height: 20px; stroke: currentColor; }
.nav-modul:hover .nav-modul-arrow {
  color: var(--pink);
  transform: translateX(4px);
}
.nav-modul-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: var(--pink-deep);
  color: #fff;
  font-size: 0.72rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-weight: 600;
  padding: 0.75rem 1.25rem;
  border-radius: 100px;
  transition: background 0.2s, box-shadow 0.2s;
  min-height: 44px; /* łatwy w kliknięciu kciukiem */
}
.nav-modul:hover .nav-modul-btn {
  background: var(--pink);
  color: var(--text);
  box-shadow: 0 6px 18px rgba(249,184,204,0.3);
}

/* ── MAPA ── */
.mapa-wrap {
  position: relative;
  width: 100%;
  height: 460px;
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(232,120,154,0.2);
}
.mapa-wrap iframe {
  width: 100%; height: 100%;
  border: 0;
}
.mapa-overlay {
  position: absolute; inset: 0;
  background: transparent;
  cursor: pointer;
  display: flex; align-items: flex-end; justify-content: center;
  padding-bottom: 1.5rem;
  pointer-events: all;
}
.mapa-overlay span {
  background: rgba(46,18,32,0.7);
  backdrop-filter: blur(6px);
  color: rgba(249,184,204,0.9);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 0.45rem 1rem;
  border-radius: 100px;
  pointer-events: none;
}

/* ── TRASA BTN (stary - zachowany) ── */
.trasa-btn {
  display: block;
  margin-top: 1rem;
  background: var(--text);
  color: var(--pink-light);
  text-align: center;
  font-size: 0.75rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  font-weight: 500;
  padding: 0.85rem 1.5rem;
  border-radius: 100px;
  text-decoration: none;
  transition: background 0.25s, color 0.25s, transform 0.2s;
  box-shadow: 0 6px 20px rgba(46,18,32,0.2);
}
.trasa-btn:hover {
  background: var(--pink-deep);
  color: #fff;
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(232,120,154,0.35);
}
.onas-address {
  position: absolute; bottom: 1.5rem; left: 1.5rem;
  background: rgba(255,255,255,0.8); backdrop-filter: blur(8px);
  border-radius: 100px; padding: 0.45rem 1.1rem;
  font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--text-mid); font-weight: 500; z-index: 3;
}
.onas-badge {
  position: absolute; top: -12px; right: -12px;
  background: var(--pink-deep); color: #fff;
  width: 86px; height: 86px; border-radius: 50%;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 1px; z-index: 4;
  box-shadow: 0 8px 20px rgba(232,120,154,0.35);
}
.onas-badge-num { font-family: 'Playfair Display', serif; font-size: 1.7rem; font-weight: 700; line-height: 1; }
.onas-badge-text { font-size: 0.5rem; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.8; }

.onas-content p { font-size: 0.95rem; line-height: 1.85; color: var(--text-mid); font-weight: 300; margin-bottom: 1rem; }
.values-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-top: 2rem; }
.value-chip {
  background: var(--white); border: 1px solid var(--border);
  border-radius: 16px; padding: 1.1rem 0.75rem; text-align: center;
}
.value-chip-icon { font-size: 1.4rem; margin-bottom: 0.35rem; }
.value-chip-name { font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-mid); font-weight: 500; }

/* ── KONTAKT ── */
.kontakt { background: var(--text); }
.kontakt-layout { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: start; max-width: 600px; }
.kontakt-left .section-title { color: var(--pink-light); }
.kontakt-left .eyebrow { color: var(--pink); }
.kontakt-left > p { font-size: 0.92rem; line-height: 1.8; color: rgba(249,184,204,0.5); font-weight: 300; margin-top: 0.75rem; margin-bottom: 2rem; }

.info-rows { display: flex; flex-direction: column; gap: 1.1rem; }
.info-row { display: flex; gap: 0.9rem; align-items: flex-start; }
.info-icon { font-size: 1rem; margin-top: 0.1rem; }
.info-label { font-size: 0.62rem; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(249,184,204,0.3); margin-bottom: 0.2rem; }
.info-val { font-size: 0.9rem; color: #FFF0F5; font-weight: 300; }

.hours { margin-top: 0.5rem; }
.hrow { display: flex; justify-content: space-between; font-size: 0.85rem; color: rgba(249,184,204,0.45); padding: 0.35rem 0; border-bottom: 1px solid rgba(249,184,204,0.08); font-weight: 300; }
.hrow:last-child { border-bottom: none; }
.hrow span:last-child { color: rgba(249,184,204,0.8); }

.cform { display: flex; flex-direction: column; gap: 1rem; }
.flabel { font-size: 0.62rem; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(249,184,204,0.35); display: block; margin-bottom: 0.35rem; }
.ffield { display: flex; flex-direction: column; }
.ffield input, .ffield textarea {
  background: rgba(255,240,245,0.05); border: 1px solid rgba(249,184,204,0.15);
  color: #FFF0F5; padding: 0.85rem 1rem;
  font-family: 'DM Sans', sans-serif; font-size: 0.88rem; font-weight: 300;
  outline: none; border-radius: 10px; transition: border-color 0.2s; resize: none;
}
.ffield input::placeholder, .ffield textarea::placeholder { color: rgba(249,184,204,0.2); }
.ffield input:focus, .ffield textarea:focus { border-color: var(--pink-deep); }
.fsend {
  background: var(--pink-deep); color: #fff; border: none;
  padding: 0.9rem 2rem; font-family: 'DM Sans', sans-serif;
  font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase;
  font-weight: 500; cursor: pointer; border-radius: 100px;
  transition: background 0.2s; align-self: flex-start;
}
.fsend:hover { background: var(--pink); color: var(--text); }

/* ── FOOTER ── */
footer {
  background: var(--text);
  border-top: 1px solid rgba(249,184,204,0.08);
  padding: 2rem 3rem;
  display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem;
}
.foot-logo { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; font-style: italic; color: var(--pink-light); }
.foot-logo span { color: var(--pink-deep); }
.foot-social { display: flex; gap: 0.75rem; }
.slink {
  width: 36px; height: 36px; border-radius: 50%;
  border: 1px solid rgba(249,184,204,0.2); color: var(--pink-light);
  display: flex; align-items: center; justify-content: center;
  text-decoration: none; transition: all 0.2s;
}
.slink:hover { background: var(--pink-deep); border-color: var(--pink-deep); }
.slink svg { width: 15px; height: 15px; fill: currentColor; }
.foot-copy { font-size: 0.7rem; color: rgba(249,184,204,0.25); }

/* ── ANIM ── */
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
.fade-up { opacity: 0; transform: translateY(22px); transition: opacity 0.65s ease, transform 0.65s ease; }
.fade-up.vis { opacity: 1; transform: translateY(0); }

/* ── MOBILE ── */
@media (max-width: 900px) {
  nav { padding: 1rem 1.5rem; }
  .nav-links { display: none; }
  section { padding: 5rem 1.5rem; }
  .hero { padding: 6rem 1.5rem 3rem; }
  .hero-inner { grid-template-columns: 1fr; }
  .hero-visual { display: none; }
  .services-layout { grid-template-columns: 1fr; gap: 2.5rem; }
  .services-grid { grid-template-columns: 1fr; }
  .galeria-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
  .galeria-item:first-child { grid-row: span 1; }
  .opinions-grid { grid-template-columns: 1fr; }
  .onas-layout { grid-template-columns: 1fr; gap: 3rem; }
  .kontakt-layout { grid-template-columns: 1fr; gap: 3rem; }
  footer { padding: 2rem 1.5rem; }
}
@media (max-width: 500px) {
  .galeria-grid { grid-template-columns: 1fr; }
  .hero-headline { font-size: 2.6rem; }
}
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <a href="#" class="nav-logo">Los<span>Lodos</span></a>
  <ul class="nav-links">
    <li><a href="#uslugi">Oferta</a></li>
    <li><a href="#menu">Menu</a></li>
    <li><a href="#opinie">Opinie</a></li>
    <li><a href="#onas">O nas</a></li>
  </ul>
  <a href="#kontakt" class="nav-cta">Kontakt</a>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div class="fade-up">
      <span class="hero-tag">Lodziarnia Rzemieślnicza · Lubin</span>
      <h1 class="hero-headline">
        Smaki,<br>które <em>kochasz</em><br>od pierwszej chwili
      </h1>
      <p class="hero-sub">Lody naturalne, Bubble Waffle, Bubble Tea i kawa z pasją — w sercu Lubina, przy ul. 1 Maja 16A.</p>
      <div class="hero-btns">
        <a href="#menu" class="btn-main">Zobacz menu</a>
        <a href="#kontakt" class="btn-outline">Znajdź nas</a>
      </div>
    </div>

    <div class="hero-visual fade-up">
      <div class="hero-card">
        <!--
          ZDJĘCIE HERO
          Wrzuć plik: zdjecia/hero.png
          (najlepiej .png z przezroczystym tłem)
          Następnie zamień display:none → display:block w img poniżej
          i usuń div.hero-card-emoji
        -->
        <img src="zdjecia/hero.png" alt="Bubble Waffle z lodami"
             onload="this.style.display='block'; this.nextElementSibling.style.display='none'">
        <div class="hero-card-emoji">🍦</div>
        <div class="hero-card-label">Bubble Waffle · Lody · Bubble Tea</div>
      </div>
      <div class="hero-badge">
        <span class="hero-badge-num">4,6</span>
        <span class="hero-badge-text">638 opinii</span>
      </div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee-wrap">
  <div class="marquee-track">
    <span class="marquee-item">Lody Rzemieślnicze</span>
    <span class="marquee-item">Bubble Waffle</span>
    <span class="marquee-item">Bubble Tea</span>
    <span class="marquee-item">Pistacjowe Latte</span>
    <span class="marquee-item">Solony Karmel</span>
    <span class="marquee-item">Lody na Wynos</span>
    <span class="marquee-item">Czekoladowe Shake</span>
    <span class="marquee-item">Lody Rzemieślnicze</span>
    <span class="marquee-item">Bubble Waffle</span>
    <span class="marquee-item">Bubble Tea</span>
    <span class="marquee-item">Pistacjowe Latte</span>
    <span class="marquee-item">Solony Karmel</span>
    <span class="marquee-item">Lody na Wynos</span>
    <span class="marquee-item">Czekoladowe Shake</span>
  </div>
</div>

<!-- SERVICES -->
<section class="services" id="uslugi">
  <div class="container">
    <div class="services-layout">
      <div class="fade-up">
        <p class="eyebrow">Nasza oferta</p>
        <h2 class="section-title">Każda wizyta to<br><em>nowe odkrycie</em></h2>
        <p>Rotujące smaki, sezonowe specjały i klasyki, które nigdy nie zawodzą. Tu zawsze znajdziesz coś dla siebie.</p>
      </div>
      <div class="services-grid fade-up">
        <div class="service-card" style="padding:0;overflow:hidden;">
          <img src="data:image/jpeg;base64," alt="Lody rzemieślnicze" style="width:100%;height:auto;object-fit:contain;display:block;border-radius:20px 20px 0 0;background:#FFF0F5;">
          <div style="padding:1.5rem 2rem 2rem;">
            <p class="service-name">Lody Rzemieślnicze</p>
            <p class="service-desc">Naturalne składniki, zmieniające się smaki — od solonego karmelu po pistacje.</p>
            <p class="service-price">od 8 zł / porcja</p>
          </div>
        </div>
        <div class="service-card" style="padding:0;overflow:hidden;">
          <img src="data:image/jpeg;base64," alt="Bubble Waffle" style="width:100%;height:auto;object-fit:contain;display:block;border-radius:20px 20px 0 0;background:#FFF0F5;">
          <div style="padding:1.5rem 2rem 2rem;">
            <p class="service-name">Bubble Waffle</p>
            <p class="service-desc">Puszysty gofr bąbelkowy w wersjach klasycznych i Maxi z lodami i polewą.</p>
            <p class="service-price">od 12 zł</p>
          </div>
        </div>
        <div class="service-card" style="padding:0;overflow:hidden;">
          <img src="data:image/jpeg;base64," alt="Bubble Tea" style="width:100%;height:auto;object-fit:contain;display:block;border-radius:20px 20px 0 0;background:#FFF0F5;">
          <div style="padding:1.5rem 2rem 2rem;">
            <p class="service-name">Bubble Tea</p>
            <p class="service-desc">Mrożona herbata mleczna z poppingami w dowolnym smaku. L lub XL.</p>
            <p class="service-price">od 18 zł</p>
          </div>
        </div>
        <div class="service-card" style="padding:0;overflow:hidden;">
          <img src="data:image/jpeg;base64," alt="Pistacjowe Latte Macchiato" style="width:100%;height:auto;object-fit:contain;display:block;border-radius:20px 20px 0 0;background:#FFF0F5;">
          <div style="padding:1.5rem 2rem 2rem;">
            <p class="service-name">Kawa & Shake</p>
            <p class="service-desc">Pistacjowe latte, espresso tonic, shake Oreo — coś dla każdego.</p>
            <p class="service-price">od 10 zł</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- MENU -->
<section class="menu-section" id="menu">
